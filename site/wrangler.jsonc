// Cloudflare (Pages, now Workers static assets): uploads the static export in out/.
// Deploy: pnpm build && npx wrangler deploy
{
  "name": "tabgroups",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "routes": [{ "pattern": "tabgroups.passion7.cc", "custom_domain": true }],
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
